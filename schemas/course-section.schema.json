{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhulden/ncfbot/schemas/course-section.schema.json",
  "title": "NCF Public Course Section",
  "description": "One normalized public Banner section. Identity is the exact pair (term_code, crn).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "term_code",
    "term_label",
    "subject",
    "course_number",
    "course_display",
    "section",
    "crn",
    "title",
    "instructors",
    "meetings",
    "meeting_summary",
    "credits_or_units",
    "attributes",
    "description",
    "prerequisites",
    "corequisites",
    "restrictions",
    "mutual_exclusions",
    "catalog_details",
    "linked_sections",
    "cross_listed_sections",
    "detail_level",
    "detail_status",
    "source_url",
    "retrieved_at",
    "enrollment"
  ],
  "properties": {
    "term_code": {"type": "string", "minLength": 1},
    "term_label": {"type": "string", "minLength": 1},
    "subject": {"type": "string"},
    "course_number": {"type": "string"},
    "course_display": {"type": "string"},
    "section": {"type": ["string", "null"]},
    "crn": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "instructors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "meetings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["days", "begin_time", "end_time", "start_date", "end_date", "building", "building_description", "room", "campus", "campus_description", "meeting_type", "meeting_type_description", "schedule_type", "instructors"],
        "properties": {
          "days": {"type": "array", "items": {"enum": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}, "uniqueItems": true},
          "begin_time": {"type": ["string", "null"]},
          "end_time": {"type": ["string", "null"]},
          "start_date": {"type": ["string", "null"]},
          "end_date": {"type": ["string", "null"]},
          "building": {"type": ["string", "null"]},
          "building_description": {"type": ["string", "null"]},
          "room": {"type": ["string", "null"]},
          "campus": {"type": ["string", "null"]},
          "campus_description": {"type": ["string", "null"]},
          "meeting_type": {"type": ["string", "null"]},
          "meeting_type_description": {"type": ["string", "null"]},
          "schedule_type": {"type": ["string", "null"]},
          "instructors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "meeting_summary": {"type": ["string", "null"]},
    "credits_or_units": {"type": ["number", "string", "null"]},
    "attributes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "description": {"type": ["string", "null"]},
    "prerequisites": {"type": ["string", "null"]},
    "corequisites": {"type": ["string", "null"]},
    "restrictions": {"type": ["string", "null"]},
    "mutual_exclusions": {"type": ["string", "null"]},
    "catalog_details": {"type": ["string", "null"]},
    "linked_sections": {"type": ["string", "null"]},
    "cross_listed_sections": {"type": ["string", "null"]},
    "detail_level": {"enum": ["listing", "enriched"]},
    "detail_status": {"enum": ["not_requested", "success", "partial", "failed"]},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "enrollment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "maximum", "enrolled", "seats_available", "wait_capacity", "wait_count", "wait_available", "open_section", "retrieved_at", "freshness"],
      "properties": {
        "status": {"enum": ["open", "closed", "unknown"]},
        "maximum": {"type": ["integer", "null"]},
        "enrolled": {"type": ["integer", "null"]},
        "seats_available": {"type": ["integer", "null"]},
        "wait_capacity": {"type": ["integer", "null"]},
        "wait_count": {"type": ["integer", "null"]},
        "wait_available": {"type": ["integer", "null"]},
        "open_section": {"type": ["boolean", "null"]},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "freshness": {"enum": ["snapshot", "live"]}
      }
    }
  }
}
