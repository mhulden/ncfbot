digraph NCFBotIssueDependenciesSummary {
  graph [
    rankdir=TB,
    bgcolor="white",
    fontname="Helvetica",
    fontsize=18,
    label="NCF Bot Issue Dependencies — Compact DAG",
    labelloc=t,
    pad=0.25,
    nodesep=0.35,
    ranksep=0.55,
    splines=polyline
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#334155",
    fillcolor="white",
    fontname="Helvetica",
    fontsize=10,
    margin="0.14,0.09"
  ];
  edge [color="#64748b", fontname="Helvetica", fontsize=9, arrowsize=0.7];

  normalize [
    shape=oval,
    fillcolor="#e2e8f0",
    label="Normalize tracker\nKeep #9 and #12–15 closed\nClose #19 into #16\nCorrect #11, #20, #24, #26"
  ];

  independent [
    fillcolor="#dbeafe",
    label="Independent issue work can start in parallel\n\nA1: #10 scope; #18 emergency\nA2: #24 quotation precision\nA3: #16 ALC conflict; #21 faculty systems\nA4: #20 admissions; #22 scholarships; #23 library\nA5: #11 HTML converter; #36 POSIX manifest paths\nA6: #25 program-level course frequency"
  ];

  evidence [
    fillcolor="#fef9c3",
    label="A7: #38 reconcile Round 1 evidence\nRecover HT-024, HT-026, HT-031–034\nCorrect scores and test-to-issue links"
  ];

  private_answer [
    fillcolor="#dcfce7",
    label="A2: #35 / HT-026 private-record fix\nRequires matching transcript"
  ];
  history_route [
    fillcolor="#dcfce7",
    label="A2: #26 historical comparison route\nRequires matching answer or reclassification"
  ];
  ambiguity [
    shape=diamond,
    fillcolor="#fef3c7",
    label="Do HT-031–034 notes\nshow distinct defects?"
  ];
  followups [
    style="rounded,dashed,filled",
    fillcolor="#fff7ed",
    label="Open only the resulting\nevidence-backed issues"
  ];

  metadata [
    fillcolor="#ffe4e6",
    label="A5: #37 structured metadata prototype\nRequired-resource + known-conflict fields"
  ];
  faculty_targets [
    fillcolor="#ffedd5",
    label="A3 target fixes available\n#16 / HT-028 and #21 / HT-009"
  ];
  enforcement [
    fillcolor="#fef9c3",
    label="A7: #40 enforcement pilot\nConsume metadata using HT-009 + HT-028\nInclude missing-resource control"
  ];

  run_record [
    fillcolor="#fef9c3",
    label="A7: #39 Round 2 run-record format\nRevision, model, resources, tools, latency,\nfull answer, scores, issue and PR"
  ];

  integrate [
    shape=oval,
    fillcolor="#e2e8f0",
    label="Merge non-conflicting PRs\nRun doctor, source validation, evaluator and pytest"
  ];
  rerun [
    shape=oval,
    fillcolor="#dcfce7",
    label="Focused Round 2 human reruns\nCritical cases plus nearby passing controls"
  ];
  closeout [
    shape=doublecircle,
    fillcolor="#bbf7d0",
    label="Close issues only after\nmerge + behavioral pass"
  ];

  normalize -> independent;
  normalize -> evidence;
  normalize -> metadata;
  normalize -> run_record;

  evidence -> private_answer;
  evidence -> history_route;
  evidence -> ambiguity;
  ambiguity -> followups [label="yes"];
  ambiguity -> integrate [label="no"];
  followups -> integrate;

  independent -> faculty_targets [label="complete #16 and #21"];
  metadata -> enforcement;
  faculty_targets -> enforcement;

  independent -> integrate;
  private_answer -> integrate;
  history_route -> integrate;
  metadata -> integrate;
  enforcement -> integrate;

  integrate -> rerun;
  run_record -> rerun;
  rerun -> closeout;
}
